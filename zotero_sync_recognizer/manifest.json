{
  "manifest_version": 2,
  "name": "Zotero Sync Recognizer",
  "version": "0.2.1",
  "description": "Exposes local HTTP endpoints for standalone PDF metadata recognition",
  "author": "Oh My Pi",
  "applications": {
    "zotero": {
      "id": "zotero-sync-recognizer@example.com",
      "update_url": "https://example.com/zotero-sync-recognizer/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "9.*"
    }
  }
}
